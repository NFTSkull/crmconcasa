# ConCasa CRM — variables de entorno (ejemplo)

# --- Supabase (app) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_DATA_MODE=supabase
NEXT_PUBLIC_USE_SUPABASE_AUTH=true

# --- Google Sheets agenda sync (Edge / ops; NUNCA valores reales en Git) ---
GOOGLE_SHEETS_SPREADSHEET_ID=1JOERzJc2yLncDbzTFG2lQLQXdlWwmGehlxP7JNOoupA
GOOGLE_SERVICE_ACCOUNT_EMAIL=sheets-sync@your-gcp-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREDACTED\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEETS_WEBHOOK_SECRET=replace-with-long-random-string
GOOGLE_SHEETS_WORKER_SECRET=replace-with-long-random-string-for-cron
GOOGLE_SHEETS_SYNC_ENABLED=false

# --- Cron Vercel: reintentos auto-precalificar (header x-cron-secret o Authorization Bearer) ---
CRON_SECRET=replace-with-long-random-string-for-vercel-cron
GOOGLE_SHEETS_ORGANIZATION_ID=00000000-0000-4000-8000-000000000001
GOOGLE_SHEETS_YEAR=2026
GOOGLE_SHEETS_TAB_MAP_JSON={"2026-07-29":{"sheetId":1288978311,"title":"29 JULIO"}}

# --- Gate fiscal SAT (P228; server-only) ---
# Service role solo en servidor (nunca NEXT_PUBLIC_*). Necesario para server_registrar_validacion_fiscal_sat.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Worker CapSolver live (Railway u otro). Solo se llama si fiscal_sat_gate aplica al expediente.
SAT_VALIDATOR_URL=https://your-sat-validator.example.com
SAT_VALIDATOR_SECRET=replace-with-long-random-string
